    "@milkdown/kit": "^7.23.0",
    "@milkdown/react": "^7.23.0",
    "@milkdown/utils": "^7.23.0",
    "@reactour/tour": "^3.8.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@viz-js/lang-dot": "^1.0.5",
