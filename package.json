{
  "name": "@juki-team/base-ui",
  "version": "1.4.133",
  "repository": "https://github.com/juki-team/base-ui",
  "author": "juki-team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/cjs/main.js",
  "module": "dist/esm/main.js",
  "types": "dist/module-types/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.sass",
    "src/styles/**",
    "src/vendor/**",
    "dist/styles/**"
  ],
  "files": [
    "dist",
    "src/vendor",
    "src/styles",
    "LLMS.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/module-types/src/index.d.ts",
      "react-server": "./dist/esm/server.js",
      "import": "./dist/esm/main.js",
      "require": "./dist/cjs/main.js"
    },
    "./server-components": {
      "types": "./dist/module-types/src/components/server/index.d.ts",
      "import": "./dist/esm/server.js",
      "require": "./dist/cjs/server.js"
    },
    "./helpers": {
      "types": "./dist/module-types/src/helpers/index.d.ts",
      "import": "./dist/esm/helpers.js",
      "require": "./dist/cjs/helpers.js"
    },
    "./enums": {
      "types": "./dist/module-types/src/enums/index.d.ts",
      "import": "./dist/esm/enums.js",
      "require": "./dist/cjs/enums.js"
    },
    "./types": {
      "types": "./dist/module-types/src/types/index.d.ts",
      "import": "./dist/esm/types.js",
      "require": "./dist/cjs/types.js"
    },
    "./constants": {
      "types": "./dist/module-types/src/constants/index.d.ts",
      "import": "./dist/esm/constants.js",
      "require": "./dist/cjs/constants.js"
    },
    "./settings": {
      "types": "./dist/module-types/src/settings/index.d.ts",
      "import": "./dist/esm/settings.js",
      "require": "./dist/cjs/settings.js"
    },
    "./styles/mixins": {
      "sass": "./src/styles/_mixins.scss"
    },
    "./styles.scss": "./src/styles/index.scss",
    "./vendor-styles.scss": "./src/styles/vendor/index.scss"
  },
  "scripts": {
    "caddy": "caddy run --config Caddyfile",
    "dev": "cross-env NODE_ENV=storybook storybook dev -p 6006 --host 0.0.0.0",
    "prebuild:rollup": "rm -rf src/vendor && rollup -c prebuild-rollup.config.js && rm -rf tmp-prebuild",
    "build:storybook": "rm -rf docs && storybook build -o docs",
    "build:rollup-clean": "rm -rf dist && rm -rf node_modules/.cache/rollup-plugin-typescript2",
    "build:rollup": "rm -rf dist && rollup -c rollup.config.js --strictDeprecations --environment NODE_ENV:production",
    "build:sass": "rm -rf dist/css-styles && sass src/styles:dist/styles --no-source-map --style=compressed",
    "build:publish": "dotenv -- pnpm publish",
    "git:commit": "f() { param=${1}; message=${param:-chore}; echo ${message}; git add .; echo $message | git commit -F -; }; f",
    "git:commit-version": "version=\"v$(node -p \"require('./package.json').version\")\" && pnpm git:commit $(echo $version) && git tag -a $(echo $version) -m $(echo $version);",
    "git:push": "git push origin main && git push origin --tags",
    "push-commit": "f() { pnpm check:circular-deps && pnpm git:commit \"${1}\" && npm version patch --no-git-tag-version && pnpm build:rollup-clean && pnpm build:rollup && pnpm git:commit-version && pnpm build:publish && pnpm git:push; }; f",
    "push": "npm login && pnpm check:circular-deps && pnpm build:rollup-clean && pnpm build:rollup && pnpm version patch && pnpm build:publish && pnpm git:push",
    "push:storybook": "f() { pnpm check:circular-deps && pnpm git:commit \"${1}\" && npm version patch --no-git-tag-version && pnpm build:rollup-clean && pnpm build:sass && pnpm build:storybook && pnpm git:commit-version && pnpm build:publish && pnpm git:push; }; f",
    "pull": "rm -rf node_modules/@juki-team pnpm-lock.yaml && pnpm add @juki-team/commons@latest",
    "chromatic": "npx chromatic --project-token=xyz",
    "clean-and-reset": "rm -rf node_modules pnpm-lock.yaml && pnpm store prune && pnpm install",
    "check-style-files": "find src/styles -type f -name \"*.scss\" -exec stat -f \"%z %N\" {} + | awk '{printf \"%.1f KB %s\\n\", $1/1024, $2}' | sort -nr",
    "outdated": "npx npm-check-updates",
    "check:circular-deps": "npx madge --circular ./src/*",
    "check:circular-deps-graph": "npx madge --circular ./dist/* --image deps.png",
    "doctor": "react-doctor"
  },
